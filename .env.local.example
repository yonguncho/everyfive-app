# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored via .env.* pattern.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# WARNING: service_role key bypasses RLS. Only for server-side code and edge functions.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Lemon Squeezy (https://app.lemonsqueezy.com/settings/api)
LEMON_SQUEEZY_API_KEY=<api-key>
LEMON_SQUEEZY_STORE_ID=<store-id>
LEMON_SQUEEZY_WEBHOOK_SECRET=<webhook-secret>

# EveryFive Variant IDs (Products → EveryFive Pro → Variants에서 확인)
LEMON_SQUEEZY_VARIANT_PRO_10=
LEMON_SQUEEZY_VARIANT_PRO_20=
LEMON_SQUEEZY_VARIANT_PRO_30=

# App public URL — used for CORS origin in Edge Functions
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 콘텐츠 CDN (Vercel deployment URL)
NEXT_PUBLIC_CONTENT_BASE_URL=https://everyfive-content.vercel.app
